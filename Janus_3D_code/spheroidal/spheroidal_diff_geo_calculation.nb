        RowBox[{"v", "^", "2"}]}], "]"}], " ", 
      RowBox[{"Cos", "[", "\[Phi]", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"y", "=", 
     RowBox[{"a", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"u", "^", "2"}], "-", "1"}], "]"}], " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "-", 
        RowBox[{"v", "^", "2"}]}], "]"}], " ", 
      RowBox[{"Sin", "[", "\[Phi]", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"z", "=", 
     RowBox[{"a", " ", "u", " ", "v"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rVec", "=", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Re", "-", 
     RowBox[{
     "define", " ", "scale", " ", "factors", " ", "for", " ", "this", " ", 
      "calculation"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"hU", "=", 
     RowBox[{"a", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"u", "^", "2"}], "-", 
          RowBox[{"v", "^", "2"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"u", "^", "2"}], "-", "1"}], ")"}]}], "]"}]}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"hV", "=", 
     RowBox[{"a", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"u", "^", "2"}], "-", 
          RowBox[{"v", "^", "2"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"v", "^", "2"}]}], ")"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hPhi", "=", 
     RowBox[{"a", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"u", "^", "2"}], "-", "1"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"v", "^", "2"}]}], ")"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calculate", " ", "the", " ", "unit", " ", "vectors", " ", "by", " ", 
     "differentiating", " ", "the", " ", "position", " ", "vector", " ", 
     "and", " ", "normalizing"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"uHat", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"rVec", ",", "u"}], "]"}], "/", "hU"}], ",", 
       RowBox[{
        RowBox[{"u", ">=", "1"}], "&&", 
        RowBox[{
         RowBox[{"-", "1"}], "<=", "v", "<=", "1"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"vHat", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"rVec", ",", "v"}], "]"}], "/", "hV"}], ",", 
       RowBox[{
        RowBox[{"u", ">=", "1"}], "&&", 
        RowBox[{
         RowBox[{"-", "1"}], "<=", "v", "<=", "1"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"phiHat", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{"rVec", ",", "\[Phi]"}], "]"}], "/", "hPhi"}], ",", 
       RowBox[{
        RowBox[{"u", ">=", "1"}], "&&", 
        RowBox[{
         RowBox[{"-", "1"}], "<=", "v", "<=", "1"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"cartesianToProlateMatrix", "=", 
     RowBox[{"{", 
      RowBox[{"uHat", ",", "vHat", ",", "phiHat"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"prolateToCartesianMatrix", "=", 
     RowBox[{"Transpose", "[", "cartesianToProlateMatrix", "]"}]}], 
    ";"}]}]}]], "Input",
