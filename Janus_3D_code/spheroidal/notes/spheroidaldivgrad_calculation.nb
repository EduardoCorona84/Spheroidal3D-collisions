      "\[IndentingNewLine]", 
      RowBox[{"termPhi", "=", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"Fphi", "*", "hU", "*", "hV"}], ",", "phi"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"hU", " ", "hV", " ", "hPhi"}], ")"}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"termU", "+", "termV", "+", "termPhi"}], ")"}]}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
