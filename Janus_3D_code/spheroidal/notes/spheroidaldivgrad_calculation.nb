       RowBox[{"u", ">=", "1"}], "&&", 
       RowBox[{
        RowBox[{"-", "1"}], "<=", "v", "<=", "1"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Cross", "[", 
