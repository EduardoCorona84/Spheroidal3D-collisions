Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"<<", "ToMatlab.m"}], "\[IndentingNewLine]", 
 RowBox[{"hU", "=", 
  RowBox[{"a", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"u", "^", "2"}], "+", 
       RowBox[{"v", "^", "2"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"u", "^", "2"}], "+", "1"}], ")"}]}], "]"}]}]}], "\n", 
 RowBox[{"hV", "=", 
  RowBox[{"a", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"u", "^", "2"}], "+", 
       RowBox[{"v", "^", "2"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"v", "^", "2"}]}], ")"}]}], "]"}]}]}], "\n", 
 RowBox[{"hPhi", "=", 
  RowBox[{"a", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"u", "^", "2"}], "+", "1"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"v", "^", "2"}]}], ")"}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rulesForMatlab", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      TemplateBox[{"g", "n", "m"},
       "Subsuperscript"], " ", "->", "gnm"}], ",", 
     RowBox[{
      TemplateBox[{"c", "n", "m"},
       "Subsuperscript"], " ", "->", "cnm"}], ",", 
     RowBox[{
      RowBox[{
       TemplateBox[{"f", "n", "m"},
        "Subsuperscript"], "[", "u", "]"}], "->", "Fr"}], ",", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         TemplateBox[{"f", "n", "m"},
          "Subsuperscript"], ")"}], "\[Prime]",
        MultilineFunction->None], "[", "u", "]"}], "->", "Fp"}], ",", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         TemplateBox[{"f", "n", "m"},
          "Subsuperscript"], ")"}], "\[Prime]\[Prime]",
        MultilineFunction->None], "[", "u", "]"}], "->", "Fpp"}], ",", 
     RowBox[{
      SubscriptBox["\[Sigma]", "1"], "->", "\"\<Gshc_x\>\""}], ",", 
     RowBox[{
      SubscriptBox["\[Sigma]", "2"], "->", "\"\<Gshc_y\>\""}], " ", ",", 
     RowBox[{
      SubscriptBox["\[Sigma]", "3"], "->", "\"\<Gshc_z\>\""}], ",", 
     RowBox[{"\[Phi]", "->", "\"\<phi\>\""}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stringReplaceRule", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Whitespace", "->", "\"\<\>\""}], ",", 
     RowBox[{"\"\<...\>\"", "->", "\"\<\>\""}], ",", 
     RowBox[{"\"\<\\n\>\"", "->", "\"\<\>\""}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"getSigmaCoefficients", "[", "expr_", "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"expr", ",", 
         RowBox[{"Subscript", "[", 
          RowBox[{"\[Sigma]", ",", "i"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "1"}], "<=", "v", "<=", "1"}], ",", 
         RowBox[{"u", ">=", "0"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"formatFCoefficientMatlabStrings", "[", 
   RowBox[{
   "expr_", ",", "nameTag_String", ",", "matlabRules_", ",", "strRules_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"Fsymbols", ",", "Fcoeffs", ",", "Fterms", ",", "Fstrings"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Fterms", "=", 
      RowBox[{"{", 
       RowBox[{"1", ",", "\[ImaginaryI]", ",", 
        RowBox[{"-", "1"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Fsymbols", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         TemplateBox[{"f", "n", "m"},
          "Subsuperscript"], "[", "u", "]"}], ",", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           TemplateBox[{"f", "n", "m"},
            "Subsuperscript"], ")"}], "\[Prime]",
          MultilineFunction->None], "[", "u", "]"}], ",", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           TemplateBox[{"f", "n", "m"},
            "Subsuperscript"], ")"}], "\[Prime]\[Prime]",
          MultilineFunction->None], "[", "u", "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Fcoeffs", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"FullSimplify", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Fterms", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "*", 
           RowBox[{"Coefficient", "[", 
            RowBox[{
             RowBox[{"Collect", "[", 
              RowBox[{"expr", ",", 
               RowBox[{"Fsymbols", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", " ", 
             RowBox[{"Fsymbols", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "1"}], "<=", "v", "<=", "1"}], ",", 
            RowBox[{"u", ">=", "0"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Fstrings", "=", 
      RowBox[{"{", 
       RowBox[{"\"\<f\>\"", ",", "\"\<fp\>\"", ",", "\"\<fpp\>\""}], "}"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"StringReplace", "[", 
        RowBox[{
         RowBox[{"ToMatlab", "[", 
          RowBox[{"ReplaceAll", "[", 
           RowBox[{
            RowBox[{"Fcoeffs", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", "matlabRules"}], "]"}], 
          "]"}], ",", "strRules"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"formatCoefficientMatlabStrings", "[", 
   RowBox[{
   "expr_", ",", "nameTag_String", ",", "matlabRules_", ",", "strRules_"}], 
   "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"coeffs", ",", "suffixes"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "1.", " ", "Get", " ", "the", " ", "list", " ", "of", " ", "three", " ", 
      "sigma", " ", "coefficients"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"coeffs", "=", 
      RowBox[{"getSigmaCoefficients", "[", "expr", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "2.", " ", "Define", " ", "the", " ", "suffixes", " ", "for", " ", 
       "the", " ", "variable", " ", "names"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"suffixes", "=", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", "\"\<y\>\"", ",", "\"\<z\>\""}], "}"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "3.", " ", "Create", " ", "a", " ", "table", " ", "of", " ", 
        "formatted", " ", "strings"}], ",", 
       RowBox[{"one", " ", "for", " ", "each", " ", "coefficient"}]}], "*)"}], 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"StringReplace", "[", 
        RowBox[{
         RowBox[{"ToMatlab", "[", 
          RowBox[{
           RowBox[{"ReplaceAll", "[", 
            RowBox[{
             RowBox[{"coeffs", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", "matlabRules"}], "]"}], 
           ",", 
           RowBox[{"StringJoin", "[", 
            RowBox[{
            "\"\<X_\>\"", ",", "nameTag", ",", "\"\<_coeff_shc\>\"", ",", 
             RowBox[{"suffixes", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "]"}], ",", 
         "strRules"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"getYnmCoefficients", "[", 
   RowBox[{
   "componentIndex_", ",", "densityIndex_", ",", "nameTag_String", ",", 
    "matlabRules_", ",", "strRules_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "commonCoeffs", ",", "component", ",", "componentYnm", ",", 
      "componentYn1m", ",", "componentYn2m"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"commonCoeffs", "=", 
      RowBox[{
       RowBox[{"Subsuperscript", "[", 
        RowBox[{"c", ",", "n", ",", "m"}], "]"}], 
       RowBox[{
        RowBox[{"Subsuperscript", "[", 
         RowBox[{"g", ",", "n", ",", "m"}], "]"}], "/", 
        RowBox[{"a", "^", "2"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"component", "=", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{"Coefficient", "[", 
         RowBox[{
          RowBox[{"Collect", "[", 
           RowBox[{
            RowBox[{"Expand", "[", 
             RowBox[{"resOb", "[", 
              RowBox[{"[", "componentIndex", "]"}], "]"}], "]"}], ",", 
            RowBox[{"Subscript", "[", 
             RowBox[{"\[Sigma]", ",", "densityIndex"}], "]"}]}], "]"}], ",", 
          " ", 
          RowBox[{"Subscript", "[", 
           RowBox[{"\[Sigma]", ",", "densityIndex"}], "]"}]}], "]"}], "]"}], 
       "/", "commonCoeffs"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"componentYnm", "=", 
