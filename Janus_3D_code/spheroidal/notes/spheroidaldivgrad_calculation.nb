   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "u", ",", "v", ",", "phi", ",", "Fu", ",", "Fv", ",", "Fphi", ",", 
       "termU", ",", "termV", ",", "termPhi"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "1.", " ", "Unpack", " ", "coordinate", " ", "variables", " ", "and", 
