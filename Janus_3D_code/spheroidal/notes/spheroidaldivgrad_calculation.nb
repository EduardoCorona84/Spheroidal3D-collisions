     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u", ",", "v", ",", "phi"}], "}"}], "=", "coords"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Fu", ",", "Fv", ",", "Fphi"}], "}"}], "=", "F"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Scale", " ", "factors"}], "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
